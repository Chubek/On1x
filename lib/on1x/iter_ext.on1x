// Iter_ext module — derived iterator adapters built on Iter.Next.
// Iterators in On1x are Tagged Lists: :Iter[state].
// The native Iter module provides Next(it) -> :Some[v] | :None.

// ForEach(it: Iterator, f: Fn) -> :Unit
// Consume the iterator, calling f on each element.
fn ForEach(it, f) {
    let continue = true
    while continue {
        match Iter.Next(it) {
            :Some[?v] => { f(v); () }
            :None     => { continue = false }
        }
    }
}

// Fold(it: Iterator, f: Fn, init) -> value
// Reduce the iterator with a binary function and initial value.
fn Fold(it, f, init) {
    let acc = init
    let continue = true
    while continue {
        match Iter.Next(it) {
            :Some[?v] => { acc = f(acc, v); () }
            :None     => { continue = false }
        }
    }
    acc
}

// Count(it: Iterator) -> :Int
// Count how many elements the iterator yields.
fn Count(it) {
    let n = 0
    let continue = true
    while continue {
        match Iter.Next(it) {
            :Some[?v] => { n = n + 1; () }
            :None     => { continue = false }
        }
    }
    n
}

// Nth(it: Iterator, n: :Int) -> :Some[v] | :None
// Skip n elements and return the next, or :None.
fn Nth(it, n) {
    // Skip first n elements.
    let i = 0
    while i < n {
        match Iter.Next(it) {
            :Some[?v] => ()
            :None     => { return :None }
        }
        i = i + 1
    }
    Iter.Next(it)
}

// Last(it: Iterator) -> :Some[v] | :None
// Consume the iterator and return the last element.
fn Last(it) {
    let last = :None
    let continue = true
    while continue {
        match Iter.Next(it) {
            :Some[?v] => { last = :Some[?v]; () }
            :None     => { continue = false }
        }
    }
    last
}

// TakeWhile(it: Iterator, pred: Fn) -> Iterator
// Stop yielding when pred returns false.
// (Returns the original iterator; the predicate is checked by the caller.)
fn TakeWhile(it, pred) {
    // This is a simplified version — a real implementation would
    // wrap the iterator with a stateful predicate check.
    // For parity testing, the native Iter.TakeWhile is the authority.
    it
}

// DropWhile(it: Iterator, pred: Fn) -> Iterator
// Skip elements while pred is true, then yield the rest.
fn DropWhile(it, pred) {
    let continue = true
    while continue {
        match Iter.Next(it) {
            :Some[?v] => (
                match pred(v) {
                    true  => ()
                    false => { return it }
                }
            )
            :None => { continue = false }
        }
    }
    it
}
