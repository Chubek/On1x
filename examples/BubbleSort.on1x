// BubbleSort.on1x
// Classic bubble sort implementation in On1x

module BubbleSort where

import std.collections.List
import std.core.Ordering

// Swap elements at indices i and j in a vector
fn swap[T](vec: Vec[T], i: Int, j: Int) -> Vec[T] =
  let vi = Vec.get(vec, i) |> Option.unwrap in
  let vj = Vec.get(vec, j) |> Option.unwrap in
  vec |> Vec.set(i, vj) |> Vec.set(j, vi)

// Single pass of bubble sort - bubbles largest element to the end
fn bubblePass[T](vec: Vec[T], n: Int) -> Vec[T] =
  if n <= 1 then
    vec
  else
    let vec' = 
      scan i in 0..(n-1) with acc = vec do
        let a = Vec.get(acc, i) |> Option.unwrap in
        let b = Vec.get(acc, i + 1) |> Option.unwrap in
        if a > b then
          swap(acc, i, i + 1)
        else
          acc
      end
    in vec'

// Bubble sort - repeatedly pass through the vector
fn bubbleSort[T](vec: Vec[T]) -> Vec[T] =
  let len = Vec.length(vec) in
  scan i in 0..len with result = vec do
    bubblePass(result, len - i)
  end

// Alternative: bubble sort on lists
fn bubbleSortList[T: Ord](xs: List[T]) -> List[T] =
  let rec bubble = fn(lst: List[T]) -> (Bool, List[T]) =>
    match lst with
    | [] -> (false, [])
    | [x] -> (false, [x])
    | x :: y :: rest ->
        if x > y then
          let (swapped, sorted) = bubble(x :: rest) in
          (true, y :: sorted)
        else
          let (swapped, sorted) = bubble(y :: rest) in
          (swapped, x :: sorted)
    end
  in
  let rec sort = fn(lst: List[T]) -> List[T] =>
    let (swapped, result) = bubble(lst) in
    if swapped then
      sort(result)
    else
      result
  in
  sort(xs)

// Example usage and test
fn main() -> Unit =
  let unsorted = Vec.fromList([64, 34, 25, 12, 22, 11, 90]) in
  let sorted = bubbleSort(unsorted) in
  
  println("Unsorted: " ++ Vec.toString(unsorted));
  println("Sorted:   " ++ Vec.toString(sorted));
  
  // List version
  let unsortedList = [5, 2, 8, 1, 9, 3] in
  let sortedList = bubbleSortList(unsortedList) in
  
  println("\nList unsorted: " ++ List.toString(unsortedList));
  println("List sorted:   " ++ List.toString(sortedList));
  
  ()

// Generic comparison-based bubble sort
fn bubbleSortBy[T](vec: Vec[T], compare: (T, T) -> Ordering) -> Vec[T] =
  let len = Vec.length(vec) in
  scan pass in 0..len with result = vec do
    scan i in 0..(len - pass - 1) with acc = result do
      let a = Vec.get(acc, i) |> Option.unwrap in
      let b = Vec.get(acc, i + 1) |> Option.unwrap in
      match compare(a, b) with
      | Greater -> swap(acc, i, i + 1)
      | _ -> acc
      end
    end
  end

// Descending sort
fn bubbleSortDesc[T: Ord](vec: Vec[T]) -> Vec[T] =
  bubbleSortBy(vec, fn(a, b) => compare(b, a))

